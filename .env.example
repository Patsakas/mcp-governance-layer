# ─────────────────────────────────────────────────────────────────────────────
# MCP Governance Layer — environment variables
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack (optional) ─────────────────────────────────────────────────────────
# OAuth bot token from https://api.slack.com/apps  (scope: chat:write)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Channel ID to post approval requests into (right-click channel → Copy link)
SLACK_CHANNEL_ID=C00000000
# Signing secret used to verify incoming Slack webhook payloads
SLACK_SIGNING_SECRET=your-signing-secret
# Set to "true" to bypass Slack signature verification (local dev / CI only)
SLACK_SKIP_SIGNATURE_VERIFICATION=false

# ── Telegram (optional) ──────────────────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=000000000:your-telegram-bot-token
# Chat ID to send approval requests to (get it from @userinfobot)
TELEGRAM_CHAT_ID=your-chat-id

# ── OpenAI (optional — powers the Blast Radius Auditor) ──────────────────────
# Without this key the auditor falls back to deterministic rule-based analysis.
OPENAI_API_KEY=sk-your-openai-key

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./governance.db

# ── Server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=9090

# ── Approval behaviour ───────────────────────────────────────────────────────
# Seconds the MCP tool waits for a human before returning a timeout
APPROVAL_TIMEOUT_SECONDS=45
